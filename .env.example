# このファイルを .env にコピーして値を書き換える
# cp .env.example .env

# Flask のセッション署名鍵。必ずランダムな値に変更すること。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# 会員登録を受け付けるか(true/false)。荒らし対策として一時的に閉じたい場合は false に。
ALLOW_REGISTRATION=true

# 既定は SQLite (data/zenfun.db)。PostgreSQL/PostGIS へ移行する場合はここを差し替える。
# 例: DATABASE_URL=postgresql://user:pass@localhost:5432/zenfun
# 移行手順は README の「PostgreSQL/PostGIS への移行」を参照。
# DATABASE_URL=

# レート制限の保存先。開発は既定でプロセス内メモリ(memory://)。
# 複数プロセス/本番運用では Redis 等の共有ストアに変更する。
# 例: RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=
